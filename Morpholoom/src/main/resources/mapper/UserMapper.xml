<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.Morpholoom.mapper.UserMapper">

    <resultMap id="UserResult" type="com.project.Morpholoom.domain.User">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="username" column="username"/>
        <result property="socialProvider" column="social_provider"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertUser" parameterType="com.project.Morpholoom.domain.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (email, password_hash, username, social_provider, created_at)
        VALUES (#{email}, #{passwordHash}, #{username}, #{socialProvider}, #{createdAt})
    </insert>

    <select id="findByEmail" parameterType="string" resultMap="UserResult">
        SELECT * FROM users WHERE email = #{email} LIMIT 1
    </select>

    <select id="findById" parameterType="long" resultMap="UserResult">
        SELECT * FROM users WHERE id = #{id}
    </select>

</mapper>

