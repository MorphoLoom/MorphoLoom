<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.Morpholoom.mapper.CreationMapper">

    <resultMap id="CreationResult" type="com.project.Morpholoom.domain.Creation">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="filename" column="filename"/>
        <result property="likes" column="likes"/>
        <result property="rankScore" column="rank_score"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertCreation" parameterType="com.project.Morpholoom.domain.Creation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO creations (user_id, title, description, filename, likes, rank_score, created_at)
        VALUES (#{userId}, #{title}, #{description}, #{filename}, #{likes}, #{rankScore}, #{createdAt})
    </insert>

    <select id="listCreations" resultMap="CreationResult">
        SELECT * FROM creations
        <choose>
            <when test="sort == 'popular'">
                ORDER BY likes DESC, created_at DESC
            </when>
            <otherwise>
                ORDER BY created_at DESC
            </otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="listByUserId" resultMap="CreationResult">
        SELECT * FROM creations
        WHERE user_id = #{userId}
        <choose>
            <when test="sort == 'popular'">
                ORDER BY likes DESC, created_at DESC
            </when>
            <otherwise>
                ORDER BY created_at DESC
            </otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="ranking" resultMap="CreationResult">
        SELECT * FROM creations ORDER BY likes DESC, rank_score DESC LIMIT #{limit}
    </select>

    <select id="findById" parameterType="long" resultMap="CreationResult">
        SELECT * FROM creations WHERE id = #{id}
    </select>

    <update id="updateLikes">
        UPDATE creations SET likes = #{likes} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM creations WHERE id = #{id}
    </delete>

</mapper>

