# LivePortrait Dockerfile (CPU 전용)
FROM ubuntu:22.04

# Python 3.10 설치
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3-pip \
    git \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Python 대안 설정 (기존 python3 심볼릭 링크 충돌 방지)
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# 작업 디렉토리 설정
WORKDIR /app

# requirements 파일 복사
COPY requirements.txt requirements_base.txt ./

# PyTorch CPU 버전 설치
RUN pip3 install --no-cache-dir torch==2.3.0 torchvision==0.18.0 torchaudio==2.3.0 --index-url https://download.pytorch.org/whl/cpu

# 나머지 의존성 설치 (onnxruntime-gpu 대신 onnxruntime 사용)
RUN pip3 install --no-cache-dir -r requirements_base.txt && \
    pip3 install --no-cache-dir onnxruntime==1.18.0 transformers==4.22.0

# HuggingFace CLI 설치 (pretrained weights 다운로드용)
RUN pip3 install --no-cache-dir "huggingface_hub[cli]"

# 전체 프로젝트 복사
COPY . .

# Entrypoint 스크립트 복사 및 실행 권한 부여
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# 포트 노출
EXPOSE 7860

# Entrypoint 설정 (pretrained weights 자동 다운로드)
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# 기본 명령어 (Gradio 앱 실행, CPU 모드 강제)
CMD ["python", "app.py", "--server_name", "0.0.0.0", "--server_port", "7860", "--flag_force_cpu"]

